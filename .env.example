# Copy to .env and fill in. Never commit .env.

# --- Application database (local Docker defaults; RDS values when deployed) ---
DB_HOST=localhost
DB_PORT=5433               # 5433 locally: a native Postgres already uses 5432; 5432 for RDS
DB_NAME=loans
DB_USER=loans
DB_PASSWORD=loans_local_pw
DB_SSLMODE=disable          # use "require" for RDS

# --- n8n (docker-compose) ---
N8N_ENCRYPTION_KEY=         # generate once: openssl rand -hex 32 ; never change it afterwards
N8N_DB_PASSWORD=n8n_local_pw
N8N_PUBLIC_URL=http://localhost:5678/

# --- n8n webhook (Workflow B) ---
N8N_WEBHOOK_URL=            # e.g. https://<tunnel>.trycloudflare.com/webhook/loan-match
N8N_WEBHOOK_SECRET=         # long random string, also set in n8n's Header Auth credential

# --- AWS (used once deployment is set up) ---
AWS_PROFILE=clickpe
AWS_REGION=ap-south-1
RDS_MASTER_PASSWORD=        # strong password for the RDS instance created by serverless.yml
DB_ALLOWED_CIDR=0.0.0.0/0   # who can reach RDS on 5432; see README "Networking"
UI_ORIGIN=*                 # origin allowed to call the API / PUT to S3 ('*' = any)
